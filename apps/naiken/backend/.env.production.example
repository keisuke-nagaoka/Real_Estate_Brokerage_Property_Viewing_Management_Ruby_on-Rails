# 本番(EC2)用の .env.production を作る際のテンプレート。
# 実際の値はGitHubにコミットせず、EC2上でのみ配置する(.gitignore で除外済み)。

# Cookie・署名に使う秘密鍵。EC2で `openssl rand -hex 64` を実行して出力された値を設定する
SECRET_KEY_BASE=change_me

# 受け付けるドメイン(Hostヘッダーの許可リスト。DNSリバインディング対策)。カンマ区切りで複数指定可
APP_HOSTS=rails.keisuke-nagaoka.com

# 画面から参照する写真のURLの先頭に付けるパス(nginx で /naiken/ 配下に配信しているため)
PUBLIC_PATH_PREFIX=/naiken

RAILS_LOG_LEVEL=info
# サーバーのメモリが少ないため、スレッド数は控えめにする
RAILS_MAX_THREADS=3

# Amazon RDS for MySQL のエンドポイント(EC2と同一VPC、Public access: No)
DB_HOST=xxxxx.xxxxxxxxxx.ap-northeast-1.rds.amazonaws.com
DB_PORT=3306
# このアプリ専用のデータベースとユーザー(RDS に管理ユーザーでログインして作成する。docs/infrastructure.md 参照)
DB_NAME=naiken_production
DB_USERNAME=naiken_app
# 推測されにくいパスワードにする(例: `openssl rand -base64 24` の出力)
DB_PASSWORD=change_me

# RDSとの通信をTLSで暗号化し、イメージに同梱したRDSのCAバンドルで証明書を検証する
# (disabled / preferred / required / verify_ca / verify_identity)
DB_SSL_MODE=verify_identity
DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

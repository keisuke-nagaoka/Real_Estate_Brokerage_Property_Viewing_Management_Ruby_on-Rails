# 本番(EC2)用の .env.production を作る際のテンプレート。
# 実際の値はGitHubにコミットせず、EC2上でのみ配置する。

# `docker compose -f compose.prod.yml run --rm naiken-api ./bin/rails secret` などで生成した値を設定する
SECRET_KEY_BASE=change_me

# Hostヘッダーの許可リスト(DNSリバインディング対策)。カンマ区切りで複数指定可
APP_HOSTS=rails.keisuke-nagaoka.com

RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3

# Amazon RDS for MySQL のエンドポイントを指定する(EC2と同一VPC、Public access: No)
DB_HOST=xxxxx.xxxxxxxxxx.ap-northeast-1.rds.amazonaws.com
DB_PORT=3306
DB_USERNAME=naiken_app
DB_PASSWORD=change_me
DB_NAME=naiken_production

# RDSとの通信をTLSで暗号化し、イメージに同梱したRDSのCAバンドルで証明書を検証する
# (disabled / preferred / required / verify_ca / verify_identity)
DB_SSL_MODE=verify_identity
DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

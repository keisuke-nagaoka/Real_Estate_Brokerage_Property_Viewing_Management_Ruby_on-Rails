# syntax=docker/dockerfile:1

# 本番(EC2)用のRails APIイメージ。開発用Dockerfileと違い、ソースとgemをイメージに焼き込む。
# ビルドコンテキストは rails_docker/ 直下 (compose.prod.yml 参照)
ARG RUBY_VERSION=3.4.11
FROM ruby:${RUBY_VERSION}-slim AS base

WORKDIR /rails

# default-mysql-client: mysql2が実行時に使うlibmariadb3を含む / libjemalloc2: メモリ断片化対策 / libvips: 物件写真のサムネイル生成
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y curl ca-certificates default-mysql-client libjemalloc2 libvips42t64 tzdata && \
    ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# RDSのTLS証明書を検証するためのCAバンドル (DB_SSL_CA で指定)
RUN curl -fsSL https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
      -o /etc/ssl/certs/rds-global-bundle.pem && \
    chmod 644 /etc/ssl/certs/rds-global-bundle.pem

ENV RAILS_ENV="production" \
    BUNDLE_DEPLOYMENT="1" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_WITHOUT="development:test" \
    LD_PRELOAD="/usr/local/lib/libjemalloc.so" \
    TZ="Asia/Tokyo" \
    LANG="C.UTF-8"


FROM base AS build
ARG APP_DIR=apps/naiken/backend

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential default-libmysqlclient-dev git libyaml-dev pkg-config && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

COPY ${APP_DIR}/Gemfile ${APP_DIR}/Gemfile.lock ./
RUN bundle install && \
    rm -rf ~/.bundle/ "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git && \
    bundle exec bootsnap precompile -j 1 --gemfile

COPY ${APP_DIR} .
RUN bundle exec bootsnap precompile -j 1 app/ lib/


FROM base

RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash

COPY --chown=rails:rails --from=build "${BUNDLE_PATH}" "${BUNDLE_PATH}"
COPY --chown=rails:rails --from=build /rails /rails
RUN mkdir -p tmp/pids log storage && chown -R rails:rails /rails

USER 1000:1000

# サーバー起動前に db:prepare (DB作成・マイグレーション) を実行する
ENTRYPOINT ["/rails/bin/docker-entrypoint"]

EXPOSE 3000
CMD ["./bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]

# syntax=docker/dockerfile:1

# 本番(EC2)用のnginxイメージ。Reactのビルド成果物と設定ファイルを焼き込み、EC2にはファイルを置かずに動かせるようにする。
# ビルドコンテキストは rails_docker/ 直下 (compose.prod.yml / GitHub Actions 参照)
FROM node:24-slim AS naiken-build
WORKDIR /app
COPY apps/naiken/frontend/package.json apps/naiken/frontend/package-lock.json ./
RUN npm ci
COPY apps/naiken/frontend .
RUN npm run build

# 新しいアプリを追加する場合は、同様のビルドステージを追加して下でCOPYする

# 本番サーバーのディスクが小さいため、軽量な alpine 版を使う
FROM nginx:stable-alpine
COPY docker/nginx/default.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=naiken-build /app/dist /usr/share/nginx/html/naiken
